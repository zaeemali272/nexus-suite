import { ListView } from "std-widgets.slint";

export struct Msg {
    author: string,
    body: string,
    h: length,
    own: bool,
}

export component AppWindow inherits Window {
    in property <[Msg]> messages;
    in-out property <length> scroll-y;
    in property <string> hud;

    width: 900px;
    height: 700px;
    title: "Spike 0.2 - virtualised list";
    background: #16161e;

    VerticalLayout {
        list := ListView {
            viewport-y <=> root.scroll-y;
            for m in root.messages: Rectangle {
                height: m.h;
                background: m.own ? #1f2335 : transparent;
                VerticalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 4px;
                    padding-bottom: 4px;
                    spacing: 2px;
                    Text {
                        text: m.author;
                        color: #7aa2f7;
                        font-size: 12px;
                        font-weight: 700;
                    }
                    Text {
                        text: m.body;
                        color: #c0caf5;
                        font-size: 14px;
                        wrap: word-wrap;
                    }
                }
            }
        }
        Rectangle {
            height: 28px;
            background: #1a1b26;
            Text {
                text: root.hud;
                color: #9ece6a;
                font-size: 12px;
                horizontal-alignment: left;
                vertical-alignment: center;
                x: 8px;
            }
        }
    }
}
