# --- BUILD STAGE ---
FROM rust:latest AS builder
WORKDIR /app

# Copy manifest files first to cache dependency compilation
COPY Cargo.toml Cargo.lock ./
COPY nexus-daemon/Cargo.toml ./nexus-daemon/
COPY nexus-core/Cargo.toml ./nexus-core/
COPY nexus-net/Cargo.toml ./nexus-net/
COPY nexus-db/Cargo.toml ./nexus-db/

# Build dummy source files to cache cargo dependencies
RUN mkdir -p nexus-daemon/src nexus-core/src nexus-net/src nexus-db/src \
    && echo "fn main() {}" > nexus-daemon/src/main.rs \
    && cargo build --release -p nexus-daemon || true

# Now copy the actual source code
COPY . .

# Touch main.rs to force recompilation of our actual code package
RUN touch nexus-daemon/src/main.rs
RUN cargo build --release -p nexus-daemon

# --- RUNTIME STAGE ---
FROM debian:bookworm-slim
WORKDIR /app

# Copy the compiled binary directly from the builder stage (No apt-get needed!)
COPY --from=builder /app/target/release/nexus-daemon /app/nexus-daemon

# Expose Quinn QUIC UDP port
EXPOSE 4433/udp

CMD ["./nexus-daemon", "--server", "--bind", "0.0.0.0:4433"]